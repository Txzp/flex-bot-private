# Copia este archivo como .env y rellena los valores. NUNCA subas el .env a GitHub.
# Sin comillas y sin espacios alrededor del =

# Developer Portal → Bot → Reset Token
DISCORD_TOKEN=pega_tu_token_aqui

# Developer Portal → General Information → Application ID
CLIENT_ID=pega_tu_application_id_aqui

# (Opcional) ID de tu servidor de pruebas, solo para npm run deploy:test / deploy:clear
GUILD_ID=

# (Opcional en tu PC, OBLIGATORIO en el hosting) MongoDB Atlas gratis, para no perder los /setup
# Ejemplo: mongodb+srv://usuario:clave@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
